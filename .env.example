# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=telemetry_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/telemetry_db

# Cache Configuration
REDIS_URL=redis://localhost:6379/0

# Vector Database Configuration
CHROMA_HOST=localhost
CHROMA_PORT=8001

# AI Configuration
# If MOCK_LLM is True, the application uses local rule-based mock responses.
# Set MOCK_LLM to False and configure OPENAI_API_KEY for actual LangChain operations.
MOCK_LLM=True
OPENAI_API_KEY=your_openai_api_key_here

# Backend configuration
PROJECT_NAME="AI Digital Twin for Laptop Telemetry"
LOG_LEVEL=info

# Frontend configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws
